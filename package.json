{
  "name": "aplikasi-sk-sekolah",
  "description": "Aplikasi SK dan Surat Tugas Sekolah - SDN 3 Loloan Timur",
  "author": "Susilo Fitri Yatmoko (Guru Merangkum)",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js dist-electron",
    "lint": "tsc --noEmit",
    "electron:dev": "concurrently \"cross-env NODE_ENV=development tsx server.ts\" \"electron electron/main.cjs\"",
    "build:exe": "npm run build && electron-builder --config electron-builder.json --win portable",
    "build:exe:portable": "npm run build && electron-builder --config electron-builder.json --win portable",
    "build:exe:installer": "npm run build && electron-builder --config electron-builder.json --win nsis",
    "build:exe:all": "npm run build && electron-builder --config electron-builder.json --win portable nsis"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
